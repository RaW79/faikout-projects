bit	dump									// Dump protocol on MQTT for each message
bit	debug				.live .hide				// Debug - logs summary of status responses
bit	debughex			.live					// Debug in hex
bit	snoop									// Listen only (for debugging)
bit	livestatus			.live					// Send status messages in real time
bit	fixstatus								// Send status as fixed values not array
bit	s21.extra			.live					// Sends extra S21 messages, usually used with dump or debug
u8	s21.tries	10		.live					// Repeat attempts at S21 controls

bit	web.control	1							// Web based controls
bit	web.settings	1							// Web based settings

s	model									// Set model name manually
s	region		eu							// Region (legacy URLs)

bit	fahrenheit			.live					// Web shows Fahrenheit

bit	no.s21				.live	.fix				// Do not try S21 protocol
bit	no.x50a				.live	.fix				// Do not try X50A protocol
bit	no.cnwired	1		.live	.fix				// Do not try CN_WIRED protocol
bit	no.as		1		.live	.fix				// Do not try (experimental) Altherma_S protocol
bit	no.swaptx			.live	.fix				// Do not try inverted Tx (use GPIO setting only)
bit	no.swaprx			.live	.fix				// Do not try inverted Rx (use GPIO setting only)

bit	no.demand								// Disable demand control
bit	no.auto									// Unit does not have auto mode
bit	no.econo								// Unit does not have econo mode
bit	no.swingv			.old="noswingw"				// Unit does not have swing (V)
bit 	no.swingh								// Unit does not have swing (H)
bit	no.comfort								// Unit does not have comfort mode
bit	no.streamer								// Unit does not have streamer mode
bit	no.powerful								// Unit does not have powerful mode
bit	no.sensor								// Unit does not have sensor mode
bit	no.quiet								// Unit does not have quiet mode
bit	no.led		1							// Unit does not have LED control
bit	no.flap									// Unit does not have flap mode
bit	no.antifreeze								// Unit does not have antifreeze mode
bit	no.humidity								// Unit does not have humidity
bit	no.humidify	1							// Unit does not have humidifier
bit	no.hourly	1		.live					// Do not do hourly S21 poll (DH)

bit	no.faikoutauto			.live.old="nofaikinauto"		// Do not show Faikout auto controls (unless already set up and no password)
bit	no.hvacaction	1							// Do not track/report hvac_action for Faikout auto mode in HA
bit	no.fanauto								// Do not control fan in Faikout auto mode
bit	no.homepreset								// Do not include a home in HA preset list
bit	no.icons			.live					// Do not show icons on web UI

bit	udp.discovery                   .old="udp_discovery"     		// Enable Daikin BRP-compatible UDP discovery

bit	ha.enable	1		.old="ha"				// Home Assistant
bit	ha.switches								// Set additional HA switches
bit	ha.fanrpm								// Use RPM not Hz for HA fan speed
bit	ha.comprpm								// Use RPM not Hz for HA comp speed
bit	ha.1c									// Force 1C steps in HA temp setting
bit	ha.periodic								// Reduce HA updates
bit	ha.ram									// Log memory usage
bit	ha.uptime								// Log uptime
s	ha.domain	"local"							// Local domain for HA links (blank for IP)

bit	cn.mark900			.live					// CN_WIRED. mark using 900uS not 1000uS

enum	fantype				.enums="Default,5 level+auto,3 level,3 level+auto"	.old="fanstep"	// Fan type override

bit	lockmode								// Do not auto switch heat/cool modes in Faikout auto

u8	protocol			.hide					// Internal protocol as found, saved when found, can be used with protofix
bit	protofix			.hide					// Protofix forces no change, use nos21, nox50a, etc instead maybe

u32	reporting	60							// Status report period (s)

u8	uart		1		.fix .hide				// UART number

u8	thermref	50		.live					// Percentage inlet rather than home temp used by your aircon

u8	switchtemp	0.5		.live	.decimal=1 .unit="℃" .old="switch10"	// Increase max (heating) or decrease min (cooling)
u8	pushtemp	0.1		.live	.decimal=1 .unit="℃" .old="push10"	// Increase min (heating) or decrease max (cooling)

s8	cool.over	6		.live	.unit="℃"			// For cooling, push (decrease) target sent to aircon by this from min to force cooling before reaching target
u8	cool.back	6		.live	.unit="℃"			// For cooling, pull (increase) target sent to aircon by this from max to stop cooling after reaching target

s8	heat.over	6		.live	.unit="℃"			// For heating, push (increase) target sent to aircon by this from max to force heating before reaching target
u8	heat.back	6		.live	.unit="℃"			// For heating, pull (decrease) target sent to aircon by this from min to stop heating after reaching target

s8	min.outside	-100		.live	.unit="℃"			// Lowest allowed outside temp allowed for operation (if known)

s8	frosttemp	-100		.live	.unit="℃"			// Frost protect (below this, turn on hot regardless)

bit	temp.track	0		.live					// Set target temp based on Daikin measured temp not required target
bit	temp.adjust	1		.live					// Adjust target temp allowing for different Daikin measure to external measure
u16	temp.noflap	0		.live	.unit="s"			// Min time between target temp changes

#ifdef CONFIG_BT_NIMBLE_ENABLED
bit	ble.enable			.hide .old="ble"				// Enable BLE for sensors or remote
s	auto.b				.live					// BLE sensor ID
#endif

bit	auto.e		1		.live					// Enable auto time and power operations
u16	auto.0				.live					// HHMM format turn off time
u16	auto.1				.live					// HHMM format turn on time
u16	auto.t				.live	.decimal=1			// Faikout auto target temperature
u8	auto.r				.live	.decimal=1			// Faikout auto margin either side of autot
bit	auto.p				.live					// Enable auto power on/off (regardless of times)
u8	auto.fmax	5		.live	.old="fmaxauto"			// Max fan setting when starting heat/cool way off from target
u8	auto.ptemp	0.5		.live	.decimal=1	.old="autop10"	// Auto power on/off by temperature deviation by this amount
bit	auto.lcontrol	0		.live					// Auto toggle on/off LED based on current HVAC action

s	auto.topic								// Topic to follow for reference temperature for Faikout auto
s	auto.payload								// JSON field in payload of above topic for reference temp

bit	thermostat			.live					// Faikout auto simple thermostat mode (heat to max, cool to min)


u8	t.min		16		.live					// Min temp setting of system
u8	t.coolmin	16		.live					// Min temp setting for Faikout auto when cooling
u8	t.max		32		.live					// Max temp setting of system
u8	t.heatmax	32		.live					// Max temp setting for Faikout auto when heating
u32	t.predicts	30							// Temp prediction sample time
u32	t.predictt	120							// Temp prediction total time factor
u32	t.sample	900							// Sample period for making adjustments
u32	t.control	600							// Control messages timeout

#ifdef  CONFIG_IDF_TARGET_ESP32S3
gpio	tx	-48								// Tx
gpio	rx	-34								// Rx
#else
#ifdef  CONFIG_IDF_TARGET_ESP32C5
gpio	tx	-26								// Tx
gpio	rx	-25								// Rx
#else
gpio	tx	-26								// Tx
gpio	rx	-27								// Rx
#endif
#endif

#if CONFIG_SOC_I2C_NUM > 1 // we need 2 I2C bus for master and slave
bit     i2c.en      0                                       // Enable I2C temp and humidity sensor spoofing
s8      i2c.htemp	4.0     .live   .decimal=1  .unit="℃"   // Offset to add to external sensor temp to reflect inlet temp when heating
s8      i2c.ctemp	-1.5    .live   .decimal=1  .unit="℃"   // Offset to add to external sensor temp to reflect inlet temp when cooling
#if defined(CONFIG_IDF_TARGET_ESP32C5)
gpio    i2c.slsda    9                                      // GPIO to use for I2C slave with Daikin board - SDA
gpio    i2c.slscl   10                                      // GPIO to use for I2C slave with Daikin board - SCL
gpio    i2c.masda    2      .fix .hide                      // GPIO to use for I2C master with inlet sensor - SDA - always LP I2C pins on this target
gpio    i2c.massl    3      .fix .hide                      // GPIO to use for I2C master with inlet sensor - SCL - always LP I2C pins on this target
#elif defined(CONFIG_IDF_TARGET_ESP32C6)
gpio    i2c.slsda    2                                      // GPIO to use for I2C slave with Daikin board - SDA
gpio    i2c.slscl    3                                      // GPIO to use for I2C slave with Daikin board - SCL
gpio    i2c.masda    6      .fix .hide                      // GPIO to use for I2C master with inlet sensor - SDA - always LP I2C pins on this target
gpio    i2c.massl    7      .fix .hide                      // GPIO to use for I2C master with inlet sensor - SCL - always LP I2C pins on this target
#elif !defined(CONFIG_REVK_ETHERNET)
gpio    i2c.slsda    9                                      // GPIO to use for I2C slave with Daikin board - SDA
gpio    i2c.slscl   10                                      // GPIO to use for I2C slave with Daikin board - SCL
gpio    i2c.masda   11                                      // GPIO to use for I2C master with inlet sensor - SDA
gpio    i2c.massl   12                                      // GPIO to use for I2C master with inlet sensor - SCL
#else
gpio    i2c.slsda                                          // GPIO to use for I2C slave with Daikin board - SDA
gpio    i2c.slscl                                         // GPIO to use for I2C slave with Daikin board - SCL
gpio    i2c.masda                                         // GPIO to use for I2C master with inlet sensor - SDA
gpio    i2c.massl                                         // GPIO to use for I2C master with inlet sensor - SCL
#endif
#endif

s       xgpio1name  .hide      // Label for Additional GPIO 1
gpio    xgpio1      .hide      // Additional GPIO 1 (not set = disabled)
bit     xgpio1out   0   .hide  // GPIO 1: Output (else Input)
bit     xgpio1pd    0   .hide  // GPIO 1: Pull-Down (Input only)
s       xgpio2name  .hide      // Label for Additional GPIO 2
gpio    xgpio2      .hide      // Additional GPIO 2
bit     xgpio2out   0   .hide  // GPIO 2: Output (else Input)
bit     xgpio2pd    0   .hide  // GPIO 2: Pull-Down (Input only)
s       xgpio3name  .hide      // Label for Additional GPIO 3
gpio    xgpio3      .hide      // Additional GPIO 3
bit     xgpio3out   0   .hide  // GPIO 3: Output (else Input)
bit     xgpio3pd    0   .hide  // GPIO 3: Pull-Down (Input only)
s       xgpio4name  .hide      // Label for Additional GPIO 4
gpio    xgpio4      .hide      // Additional GPIO 4
bit     xgpio4out   0   .hide  // GPIO 4: Output (else Input)
bit     xgpio4pd    0   .hide  // GPIO 4: Pull-Down (Input only)
s       xgpio5name  .hide      // Label for Additional GPIO 5
gpio    xgpio5      .hide      // Additional GPIO 5
bit     xgpio5out   0   .hide  // GPIO 5: Output (else Input)
bit     xgpio5pd    0   .hide  // GPIO 5: Pull-Down (Input only)
